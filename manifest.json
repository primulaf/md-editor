{
  "manifest_version": 3,
  "name": "md.",
  "version": "1.8.0",
  "description": "GitHub 风格离线 Markdown 工具，支持数学公式、PDF 打印、代码下载和 Mermaid 图表",
  "action": {
    "default_title": "打开 md. 编辑器"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["file:///*"],
  "content_scripts": [
    {
      "matches": ["file:///*.md", "file:///*.markdown"],
      "js": ["pending-file-storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
